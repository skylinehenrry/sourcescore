{
  "name": "sourcescore",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:editing-schema": "tsx scripts/editing-schema.ts",
    "test:ui": "playwright test",
    "bench": "tsx scripts/benchmark.ts",
    "compare": "tsx scripts/compare.ts",
    "desktop:dev": "node scripts/native-build.mjs && open releases/SourceScore.app",
    "desktop:build": "node scripts/native-build.mjs",
    "desktop:test": "node scripts/native-test.mjs",
    "desktop:lifecycle:test": "node scripts/native-lifecycle-test.mjs",
    "desktop:sine:test": "node scripts/native-sine-test.mjs",
    "tauri": "tauri",
    "legacy:desktop:build": "node scripts/desktop.mjs build --bundles app",
    "legacy:desktop:test": "node scripts/desktop.mjs test",
    "desktop:render:test": "node scripts/native-render-test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-react": "^0.468.0",
    "opensheetmusicdisplay": "1.9.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
